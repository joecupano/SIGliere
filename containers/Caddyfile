# TLS-first ingress. install-open-webui.sh replaces the hostname when it
# installs this file. Caddy's internal CA is the default; an operator may
# provide an existing certificate and key during installation instead.
{
	auto_https disable_redirects
}

sigliere.local:8443 {
	tls internal
	reverse_proxy 127.0.0.1:8080
}

# Private service fabric for host-networked containers. This listener is
# loopback-only: Caddy connects Open WebUI to the host Ollama and SIGedge
# gateway services without exposing either API to the LAN.
http://127.0.0.1:8180 {
	bind 127.0.0.1
	handle_path /ollama/* {
		reverse_proxy 127.0.0.1:11434
	}
	handle_path /gateway/* {
		reverse_proxy 127.0.0.1:8140
	}
	handle {
		respond 404
	}
}
