[Unit]
Description=SIGliere TLS boundary and private service router
After=network-online.target open-webui.service
Wants=open-webui.service

[Container]
Image=docker.io/library/caddy:2-alpine
ContainerName=caddy
AutoUpdate=registry

# Caddy is the sole LAN-facing process in the core deployment.
Network=host

Volume=%h/.config/containers/systemd/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=%h/.config/containers/systemd/caddy-certs:/etc/caddy/certs:ro
Volume=caddy-data:/data
Volume=caddy-config:/config

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
