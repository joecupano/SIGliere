[Unit]
Description=Open WebUI (Sigliere)
After=network-online.target

[Container]
# Pin to a known-good 0.11.x release so the documented workspace/model/tool
# workflow matches the UI that the repo now describes.
Image=ghcr.io/open-webui/open-webui:v0.11.0
ContainerName=open-webui
AutoUpdate=registry

# Core containers use host networking but bind their application listeners
# to loopback. Caddy remains the only LAN-facing process.
Network=host
Environment=HOST=127.0.0.1
Environment=PORT=8080

# App state (webui.db, vector_db/, cache/) — everything EXCEPT uploaded
# RAG documents — lives in a Podman-managed named volume, not /data.
# This is deliberately separate from the /data/rag bind mount below:
# app state isn't "static documents for RAG" in the sense docs/data-
# layout.md means, and letting Podman manage it avoids fighting Open
# WebUI's internal directory layout on a host path.
Volume=open-webui-state:/app/backend/data

# Collection databases and captures belong to SIGedge and are deliberately
# not mounted. Optional integrations may add narrowly scoped mounts.
Environment=OLLAMA_BASE_URL=http://127.0.0.1:8180/ollama
Environment=ANONYMIZED_TELEMETRY=False
Environment=WEBUI_SECRET_KEY_FILE=/app/backend/data/.webui_secret_key

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
