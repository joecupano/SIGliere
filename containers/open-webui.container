[Unit]
Description=Open WebUI (SIGliere)
After=network-online.target

[Container]
# Pin to a known-good 0.12.x release so the documented workspace/model/tool
# workflow matches the UI that the repo now describes.
Image=ghcr.io/open-webui/open-webui:v0.12.0
ContainerName=open-webui
AutoUpdate=registry

# Core containers use host networking but bind their application listeners
# to loopback. Caddy remains the only LAN-facing process.
Network=host
Environment=HOST=127.0.0.1
Environment=PORT=8080

# Open WebUI state, including its database, uploads, vector store, and cache,
# lives in a Podman-managed volume. Collection data remains outside this volume.
Volume=open-webui-state:/app/backend/data

# Collection databases and captures belong to SIGedge and are deliberately
# not mounted. The Kismet, occupancy, SigID, and MAC-vendor data is served by
# the read-only MCP server (containers/sigliere-mcp.container), which
# has its own :ro mounts, so Open WebUI no longer mounts it. Only Whisper's
# audio input is mounted here. Podman refuses to start the container if a
# source directory is missing; scripts/install-corpus-dirs.sh creates it.
Volume=/data/audio:/data/audio:ro
Environment=OLLAMA_BASE_URL=http://127.0.0.1:8180/ollama
Environment=ANONYMIZED_TELEMETRY=False
# Sovereign defaults for a FRESH install. Open WebUI stores these settings in
# its database after first start and the stored values then win, so on an
# existing host change them in Admin Panel -> Settings (see
# docs/openwebui-setup.md). Ollama through Caddy is the only model backend.
Environment=ENABLE_OPENAI_API=False
Environment=ENABLE_VERSION_UPDATE_CHECK=False
Environment=ENABLE_COMMUNITY_SHARING=False
Environment=ENABLE_CODE_INTERPRETER=False
Environment=ENABLE_CODE_EXECUTION=False
Environment=ENABLE_WEB_SEARCH=False
Environment=ENABLE_DIRECT_CONNECTIONS=False
# Knowledge/RAG embeddings: nomic-embed-text through the same private Ollama
# route (install-ollama.sh pulls it). Open WebUI's own default is a built-in
# CPU model; this keeps embedding on Ollama. Also seeds fresh installs only.
Environment=RAG_EMBEDDING_ENGINE=ollama
Environment=RAG_EMBEDDING_MODEL=nomic-embed-text
Environment=RAG_OLLAMA_BASE_URL=http://127.0.0.1:8180/ollama
Environment=WEBUI_SECRET_KEY_FILE=/app/backend/data/.webui_secret_key

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
