[Unit]
Description=Open WebUI (SIGliere)
After=network-online.target

[Container]
# Pin to a known-good 0.12.x release so the documented workspace/model/tool
# workflow matches the UI that the repo now describes.
Image=ghcr.io/open-webui/open-webui:v0.12.0
ContainerName=open-webui
AutoUpdate=registry

# Core containers use host networking but bind their application listeners
# to loopback. Caddy remains the only LAN-facing process.
Network=host
Environment=HOST=127.0.0.1
Environment=PORT=8080

# Open WebUI state, including its database, uploads, vector store, and cache,
# lives in a Podman-managed volume. Collection data remains outside this volume.
Volume=open-webui-state:/app/backend/data

# Collection databases and captures belong to SIGedge and are deliberately
# not mounted. Optional integrations get narrowly scoped, read-only mounts of
# AI-tier data only. Podman refuses to start the container if a source
# directory is missing; scripts/install-corpus-dirs.sh creates them, and a
# line can be deleted for any optional tool that is not installed.
# Kismet device mirror (written host-side by kismet-bridge.service).
Volume=/data/kismet-bridge:/data/kismet-bridge-ref:ro
# Occupancy database (written host-side by occupancy.service).
Volume=/data/occupancy:/data/occupancy-ref:ro
# SigID and MAC vendor reference mirrors (weekly timers).
Volume=/data/reference/sigid:/data/sigid-ref:ro
Volume=/data/reference/mac-vendors:/data/mac-vendors-ref:ro
# Audio for on-demand Whisper transcription.
Volume=/data/audio:/data/audio:ro
Environment=OLLAMA_BASE_URL=http://127.0.0.1:8180/ollama
Environment=ANONYMIZED_TELEMETRY=False
Environment=WEBUI_SECRET_KEY_FILE=/app/backend/data/.webui_secret_key

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
