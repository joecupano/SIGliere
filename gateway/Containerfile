FROM docker.io/library/python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY gateway/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY gateway/src /app/src
COPY gateway/config /app/config

ENV SIGLIERE_GATEWAY_HOST=127.0.0.1
ENV SIGLIERE_GATEWAY_PORT=8140
ENV SIGLIERE_SIGEDGE_NODES=/app/config/nodes.json
ENV SIGLIERE_GATEWAY_DRY_RUN=true

CMD ["python", "/app/src/sigedge_gateway.py"]

