# Installed as ~/.config/sigliere/gateway.env by the gateway installer.
SIGLIERE_GATEWAY_HOST=127.0.0.1
SIGLIERE_GATEWAY_PORT=8140
SIGLIERE_GATEWAY_DRY_RUN=true
SIGLIERE_GATEWAY_TOKENS_JSON={"replace-analyst-token":"analyst","replace-operator-token":"operator"}
# Maps SIGedge node_id -> a Kismet API key scoped to the "readonly" role
# (see https://www.kismetwireless.net/docs/api/login/), one entry per node
# that has kismet_host/kismet_port set in nodes.json. Provision each key
# with Kismet's own /auth/apikey/generate.cmd against a role-limited
# account created for the gateway, not an operator's personal login. Empty
# by default — Kismet endpoints 409 for any node without a matching entry.
SIGLIERE_GATEWAY_KISMET_CREDENTIALS_JSON={}

