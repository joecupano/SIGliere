# Copy to .env and adjust values for your host.
SIGLIERE_MCP_HOST=0.0.0.0
SIGLIERE_MCP_PORT=8140
SIGLIERE_MCP_NODES_JSON=/app/config/nodes.json

# JSON map of bearer token to role. Roles: analyst, operator.
# Example:
# {"replace-with-analyst-token": "analyst", "replace-with-operator-token": "operator"}
SIGLIERE_MCP_TOKENS_JSON={"replace-me":"operator"}

# True means do not call live radiod control hooks.
SIGLIERE_MCP_DRY_RUN=true
