# Host-side environment file for the sigliere-mcp Quadlet service.
# Copy to: ~/.config/sigliere/mcp.env

SIGLIERE_MCP_HOST=0.0.0.0
SIGLIERE_MCP_PORT=8140
SIGLIERE_MCP_DRY_RUN=true

# Token-to-role map used by the MCP service.
SIGLIERE_MCP_TOKENS_JSON={"analyst-token":"analyst","operator-token":"operator"}

# Convenience token used by scripts/openwebui-mcp-command.sh.
SIGLIERE_OPERATOR_TOKEN=operator-token
