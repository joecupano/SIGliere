cd "$SIGLIERE_SOURCE" || return 1

sudo "$SIGLIERE_SCRIPTS/install-os-packages.sh" || return 1
sudo "$SIGLIERE_SCRIPTS/install-ollama.sh" || return 1
source "$SIGLIERE_SCRIPTS/install-sigedge-gateway.sh" || return 1
source "$SIGLIERE_SCRIPTS/install-open-webui.sh" || return 1
sudo "$SIGLIERE_SCRIPTS/security-hardening.sh" || return 1
source "$SIGLIERE_SCRIPTS/validate-tiered.sh" || return 1

# Expose the repository command without copying it away from its support files.
sudo ln -sfn "$SIGLIERE_HOME/SIGliere" /usr/local/bin/SIGliere