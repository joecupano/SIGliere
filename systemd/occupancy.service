[Unit]
Description=SIGliere occupancy — poll SIGedge gateway status, log sightings
After=sigliere-gateway.service
Wants=sigliere-gateway.service

[Service]
Type=simple
# __REPO_ROOT__ and __VENV_PYTHON__ substituted by
# scripts/install-occupancy.sh at install time.
WorkingDirectory=__REPO_ROOT__/occupancy
ExecStart=__VENV_PYTHON__ __REPO_ROOT__/occupancy/occupancy_producer.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
